#!/usr/bin/env python3
"""hello_tune-player launcher -- runs the CLI from the source tree."""
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "py"))

from hellotune.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
